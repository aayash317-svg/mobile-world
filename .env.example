# Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mobile_world_db
DB_USER=mobile_user
DB_PASSWORD=your_password_here

# Application Settings
SECRET_KEY=generate-a-secure-random-key-for-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
FLAT_DELIVERY_FEE=50.00
PORT=5000
DEBUG=False

# Mail / SMTP Configuration (for Customer Email OTP & Alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=Mobile World <noreply@mobileworld.com>
